{
  "name": "uu-accelerator",
  "version": "0.1.0-preview.7",
  "private": true,
  "description": "ArmadaOS 上的 UU 加速器（网易 UU）第三方 Decky 安装管理器：下载并校验官方安装包，管理本机加速服务。",
  "type": "module",
  "author": "mydanyi",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "package": "python3 tools/package_plugin.py --output output"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
